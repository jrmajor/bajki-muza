{
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.10.0",
	"scripts": {
		"dev": "vite dev",
		"build": "php artisan ziggy:generate && vite build && vite build --ssr",
		"check": "php artisan ziggy:generate --types-only && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "php artisan ziggy:generate --types-only && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . --max-warnings 0 --cache --cache-location .cache/eslint --cache-strategy content"
	},
	"dependencies": {
		"@inertiajs/svelte": "^3.0",
		"@tailwindcss/forms": "^0.5.11",
		"esm-env": "^1.2",
		"posthog-js": "^1.364",
		"pretty-bytes": "^7.1",
		"svelte": "^5.55",
		"tailwindcss": "^4.2"
	},
	"devDependencies": {
		"@inertiajs/vite": "^3.0",
		"@jrmajor/eslint-config": "^0.3.0",
		"@sveltejs/vite-plugin-svelte": "^7.0",
		"@tailwindcss/vite": "^4.2",
		"@types/node": "^24.12",
		"eslint": "^10.1",
		"globals": "*",
		"laravel-vite-plugin": "^3.0",
		"svelte-check": "^4.4",
		"typescript": "^6.0",
		"vite": "^8.0",
		"vite-plugin-run": "^0.6.1"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.10.0"
		},
		"runtime": {
			"name": "node",
			"version": "^24.18",
			"onFail": "download"
		}
	}
}
