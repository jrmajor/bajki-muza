{
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"dev": "vite dev",
		"build": "php artisan ziggy:generate && vite build && vite build --ssr",
		"check": "php artisan ziggy:generate --types-only && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "php artisan ziggy:generate --types-only && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . --max-warnings 0 --cache --cache-location .cache/eslint --cache-strategy content"
	},
	"dependencies": {
		"@inertiajs/svelte": "^3.3",
		"@tailwindcss/forms": "^0.5.11",
		"esm-env": "^1.2",
		"posthog-js": "^1.378",
		"pretty-bytes": "^7.1",
		"svelte": "^5.56",
		"tailwindcss": "^4.3"
	},
	"devDependencies": {
		"@inertiajs/vite": "^3.3",
		"@jrmajor/eslint-config": "^0.3.0",
		"@sveltejs/vite-plugin-svelte": "^7.1",
		"@tailwindcss/vite": "^4.3",
		"@types/node": "^24.12",
		"eslint": "^10.4",
		"globals": "*",
		"laravel-vite-plugin": "^3.1",
		"svelte-check": "^4.5",
		"typescript": "^6.0",
		"vite": "^8.0",
		"vite-plugin-run": "^0.9.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "10.33.0"
		},
		"runtime": {
			"name": "node",
			"version": "^24.14",
			"onFail": "download"
		}
	}
}
